{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/manikumarkv/devrunway-claude-plugin/main/setup/stack.schema.json",
  "title": "devrunway stack.json",
  "description": "Stack configuration generated by /setup. Lists the technologies this project uses. Slots left out are inferred by the layer-autoload hook from package.json and other manifests; \"none\" means the project uses nothing in that slot.",
  "type": "object",
  "required": ["devrunway"],
  "additionalProperties": false,
  "properties": {
    "devrunway": {
      "description": "Schema version — always \"1.0\".",
      "type": "string",
      "const": "1.0"
    },
    "source-control": {
      "description": "Git provider.",
      "type": "string",
      "enum": ["github", "gitlab", "bitbucket", "azure-devops", "none"]
    },
    "ci": {
      "description": "CI/CD platform.",
      "type": "string",
      "enum": ["github-actions", "gitlab-ci", "circleci", "azure-pipelines", "none"]
    },
    "package-manager": {
      "description": "Node package manager.",
      "type": "string",
      "enum": ["npm", "pnpm", "yarn", "bun"]
    },
    "code-quality": {
      "description": "Code quality / security scanning tool.",
      "type": "string",
      "enum": ["github-security", "sonarqube", "snyk", "none"]
    },
    "frontend": {
      "description": "Frontend framework. An array when the project uses several, e.g. Astro with React islands.",
      "oneOf": [
        { "type": "string", "enum": ["react", "vue", "angular", "nextjs", "astro", "none"] },
        {
          "type": "array",
          "items": { "type": "string", "enum": ["react", "vue", "angular", "nextjs", "astro"] },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "css": {
      "description": "CSS framework or styling approach.",
      "type": "string",
      "enum": ["tailwind", "styled-components", "css-modules", "bootstrap", "none"]
    },
    "ui-components": {
      "description": "UI component library.",
      "type": "string",
      "enum": ["shadcn", "mui", "ant-design", "chakra", "none"]
    },
    "state": {
      "description": "Client-side state management library.",
      "type": "string",
      "enum": ["zustand", "redux-toolkit", "jotai", "pinia", "none"]
    },
    "i18n": {
      "description": "Internationalisation library.",
      "type": "string",
      "enum": ["react-i18next", "lingui", "vue-i18n", "none"]
    },
    "component-docs": {
      "description": "Component documentation / visual testing tool.",
      "type": "string",
      "enum": ["storybook", "ladle", "none"]
    },
    "design": {
      "description": "Design tool used by the team.",
      "type": "string",
      "enum": ["figma", "sketch", "adobe-xd", "none"]
    },
    "backend": {
      "description": "Backend runtime and framework.",
      "type": "string",
      "enum": ["node-express", "python-fastapi", "python-django", "dotnet", "none"]
    },
    "api-style": {
      "description": "API paradigm.",
      "type": "string",
      "enum": ["rest", "graphql", "trpc", "grpc", "none"]
    },
    "validation": {
      "description": "Schema validation library.",
      "type": "string",
      "enum": ["zod", "yup", "valibot", "joi", "none"]
    },
    "api-docs": {
      "description": "API documentation generator.",
      "type": "string",
      "enum": ["swagger-express", "openapi-fastapi", "none"]
    },
    "cloud": {
      "description": "Cloud provider.",
      "type": "string",
      "enum": ["aws", "gcp", "azure", "none"]
    },
    "container": {
      "description": "Container or deployment target.",
      "type": "string",
      "enum": ["serverless", "docker", "kubernetes", "vercel", "railway", "none"]
    },
    "database": {
      "description": "Primary database and ORM.",
      "type": "string",
      "enum": ["postgres-prisma", "neon", "mongodb", "dynamodb", "sqlalchemy", "none"]
    },
    "auth": {
      "description": "Authentication provider.",
      "type": "string",
      "enum": ["cognito", "firebase", "auth0", "azure-ad", "clerk", "none"]
    },
    "cache-queue": {
      "description": "Caching or message-queue technology.",
      "type": "string",
      "enum": ["redis", "sqs", "bullmq", "rabbitmq", "none"]
    },
    "storage": {
      "description": "Object / file storage provider.",
      "type": "string",
      "enum": ["s3", "gcs", "cloudinary", "uploadthing", "none"]
    },
    "secrets": {
      "description": "Secrets management strategy.",
      "type": "string",
      "enum": ["aws-secrets-manager", "doppler", "vault", "env-only"]
    },
    "feature-flags": {
      "description": "Feature flag service.",
      "type": "string",
      "enum": ["aws-appconfig", "launchdarkly", "posthog", "flagsmith", "none"]
    },
    "logging-framework": {
      "description": "Structured logging library.",
      "type": "string",
      "enum": ["pino", "winston", "morgan", "none"]
    },
    "logging-provider": {
      "description": "Log aggregation / observability destination.",
      "type": "string",
      "enum": ["cloudwatch", "datadog", "splunk", "grafana-loki", "newrelic", "none"]
    },
    "error-monitoring": {
      "description": "Error tracking and APM service.",
      "type": "string",
      "enum": ["sentry", "datadog-apm", "bugsnag", "none"]
    },
    "realtime": {
      "description": "Realtime / WebSocket service.",
      "type": "string",
      "enum": ["socketio", "pusher", "ably", "none"]
    },
    "search": {
      "description": "Full-text search service.",
      "type": "string",
      "enum": ["algolia", "typesense", "elasticsearch", "pagefind", "none"]
    },
    "payment": {
      "description": "Payment processing provider.",
      "type": "string",
      "enum": ["stripe", "paypal", "braintree", "none"]
    },
    "email": {
      "description": "Transactional email provider.",
      "type": "string",
      "enum": ["resend", "sendgrid", "ses", "none"]
    },
    "analytics": {
      "description": "Product analytics.",
      "type": "string",
      "enum": ["posthog", "none"]
    },
    "cms": {
      "description": "Content management system.",
      "type": "string",
      "enum": ["keystatic", "none"]
    },
    "testing-unit": {
      "description": "Unit and integration test runner.",
      "type": "string",
      "enum": ["vitest", "jest", "pytest", "none"]
    },
    "testing-e2e": {
      "description": "End-to-end test framework.",
      "type": "string",
      "enum": ["playwright", "cypress", "selenium", "webdriverio", "none"]
    },
    "testing-api": {
      "description": "API testing tool.",
      "type": "string",
      "enum": ["bruno", "postman", "insomnia", "none"]
    },
    "mocking": {
      "description": "API mocking library for tests.",
      "type": "string",
      "enum": ["msw", "mirage", "json-server", "none"]
    },
    "project-management": {
      "description": "Project / issue tracking tool.",
      "type": "string",
      "enum": ["github", "jira", "gitlab", "linear", "huly", "none"]
    },
    "documents": {
      "description": "Documentation / knowledge-base tool.",
      "type": "string",
      "enum": ["confluence", "notion", "none"]
    },
    "language": {
      "description": "Primary programming language.",
      "type": "string",
      "enum": ["typescript", "python", "none"]
    },
    "mobile": {
      "description": "Mobile framework.",
      "type": "string",
      "enum": ["flutter", "none"]
    },
    "notifications": {
      "description": "Push notification service.",
      "type": "string",
      "enum": ["fcm", "none"]
    },
    "policies": {
      "description": "Team policies enforced by devrunway hooks. Each is off unless set to true, so a user-level install never imposes them on a repo that didn't ask.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protect-main": {
          "description": "Deny git commit on main, master, develop and release branches.",
          "type": "boolean"
        },
        "conventional-commits": {
          "description": "Require type(scope): subject commit messages. When unset, enforced only if the repo already uses commitlint.",
          "type": "boolean"
        }
      }
    }
  }
}
